{
  "name": "fikus-miniapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4174",
    "test": "node --experimental-strip-types --test src/domain.test.ts src/commerce.test.ts src/seller.test.ts src/locale.test.ts src/admin/demo-statistics.test.ts",
    "test:localization": "node scripts/qa-localization.mjs",
    "test:ui": "node scripts/qa-admin.mjs",
    "test:services": "node scripts/qa-services.mjs",
    "test:commerce": "node scripts/qa-admin.mjs",
    "test:clawd": "node scripts/qa-clawd.mjs",
    "test:covers": "node scripts/qa-covers.mjs",
    "test:reviews": "node scripts/qa-admin.mjs",
    "test:seller": "node scripts/qa-admin.mjs",
    "server": "node --env-file-if-exists=.env server/index.mjs",
    "start": "node --env-file-if-exists=.env server/start.mjs",
    "test:server": "node --test server/*.test.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "test:admin": "node scripts/qa-admin.mjs",
    "test:access": "node scripts/qa-access.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.4"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
