# Build dist locally; production only packages the tested artifacts.
FROM node:24-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production HOST=0.0.0.0 PORT=8787 DATABASE_PATH=/app/data/fikus.sqlite
COPY --chown=node:node package.json ./
COPY --chown=node:node src ./src
COPY --chown=node:node server ./server
COPY --chown=node:node scripts/bootstrap-production.mjs ./scripts/bootstrap-production.mjs
COPY --chown=node:node dist ./dist
USER node
EXPOSE 8787
CMD ["node", "server/index.mjs"]
