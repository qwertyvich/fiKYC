# Node.js 22.18+; generate local credentials with npm run setup:local
ADMIN_PASSWORD=
BOT_TOKEN=
# 32 random bytes as 64 hex characters. Required to encrypt additional shop bot tokens.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BOTS_ENCRYPTION_KEY=
ADMIN_TELEGRAM_IDS=
SELLER_TELEGRAM_USERNAME=
PORT=8787
HOST=127.0.0.1
DATABASE_PATH=./data/fikus.sqlite
# Production: set NODE_ENV=production and your exact HTTPS origin.
# PUBLIC_ORIGIN=https://shop.example.com
# Optional exact origins retained during a domain migration, comma-separated.
# PUBLIC_ORIGIN_ALIASES=https://old-shop.example.com
# NODE_ENV=production

# Separate bot for reading card announcements and delivering receipts. Never put it in VITE_*.
GATEWAY_BOT_TOKEN=
PAY_PROVIDER_API_KEY=
PAY_PROVIDER_WEBHOOK_SECRET=
# Gateway settings: Admin panel → Оплаты (source chat, trusted sender, receipt recipient).
